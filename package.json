{
  "name": "@cmgmyr/hive",
  "version": "1.0.0",
  "description": "Shared memory and coordination for Claude Code sessions: one lead, many tmux workers, one project-scoped store.",
  "type": "module",
  "bin": {
    "hive": "dist/cli.js",
    "hive-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/gen-version.mjs",
    "check:demo": "node scripts/check-demo.mjs",
    "check:mermaid": "node scripts/check-mermaid.mjs",
    "prepublishOnly": "npm run build",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node scripts/run-tests.mjs"
  },
  "engines": {
    "node": "^22.14.0 || >=23.6.0"
  },
  "license": "MIT",
  "author": "Chris Gmyr",
  "files": [
    "dist",
    "claude-plugin",
    "profiles",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmgmyr/hive.git"
  },
  "homepage": "https://github.com/cmgmyr/hive#readme",
  "funding": "https://github.com/sponsors/cmgmyr",
  "bugs": {
    "url": "https://github.com/cmgmyr/hive/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "mcp",
    "tmux",
    "agents",
    "multi-agent",
    "sqlite",
    "coordination"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": false
  }
}
